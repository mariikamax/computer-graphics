<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.canvas.Canvas?>

<AnchorPane fx:id="anchorPane" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.cgvsu.GuiController">

    <Canvas fx:id="canvas" AnchorPane.topAnchor="30" AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="200" AnchorPane.rightAnchor="0"/>

    <!-- Меню -->
    <MenuBar AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <Menu text="File">
            <MenuItem text="Open Model" onAction="#onOpenModelMenuItemClick"/>
            <SeparatorMenuItem/>
            <MenuItem text="Save with Transformations" onAction="#onSaveModelWithTransformations"/>
            <MenuItem text="Save without Transformations" onAction="#onSaveModelWithoutTransformations"/>
        </Menu>
        <Menu text="View">
            <MenuItem text="Reset Camera" onAction="#onCameraReset"/>
            <SeparatorMenuItem/>
            <MenuItem text="Next Model" onAction="#onNextModel"/>
            <MenuItem text="Previous Model" onAction="#onPreviousModel"/>
            <MenuItem text="Remove Current Model" onAction="#onRemoveCurrentModel"/>
        </Menu>
    </MenuBar>

    <!-- Панель управления трансформациями -->
    <VBox spacing="10" style="-fx-padding: 10; -fx-background-color: #f0f0f0;"
          AnchorPane.topAnchor="30" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
          prefWidth="200">

        <Label text="Transformations" style="-fx-font-weight: bold;"/>
        <Separator/>

        <!-- Позиция -->
        <Label text="Position"/>
        <HBox spacing="5">
            <Button text="X+" onAction="#onTranslateXPlus" prefWidth="50"/>
            <Button text="X-" onAction="#onTranslateXMinus" prefWidth="50"/>
        </HBox>
        <HBox spacing="5">
            <Button text="Y+" onAction="#onTranslateYPlus" prefWidth="50"/>
            <Button text="Y-" onAction="#onTranslateYMinus" prefWidth="50"/>
        </HBox>
        <HBox spacing="5">
            <Button text="Z+" onAction="#onTranslateZPlus" prefWidth="50"/>
            <Button text="Z-" onAction="#onTranslateZMinus" prefWidth="50"/>
        </HBox>

        <Separator/>

        <!-- Вращение -->
        <Label text="Rotation"/>
        <HBox spacing="5">
            <Button text="X+" onAction="#onRotateXPlus" prefWidth="50"/>
            <Button text="X-" onAction="#onRotateXMinus" prefWidth="50"/>
        </HBox>
        <HBox spacing="5">
            <Button text="Y+" onAction="#onRotateYPlus" prefWidth="50"/>
            <Button text="Y-" onAction="#onRotateYMinus" prefWidth="50"/>
        </HBox>
        <HBox spacing="5">
            <Button text="Z+" onAction="#onRotateZPlus" prefWidth="50"/>
            <Button text="Z-" onAction="#onRotateZMinus" prefWidth="50"/>
        </HBox>

        <Separator/>

        <!-- Масштаб -->
        <Label text="Scale"/>
        <HBox spacing="5">
            <Button text="X+" onAction="#onScaleXPlus" prefWidth="50"/>
            <Button text="X-" onAction="#onScaleXMinus" prefWidth="50"/>
        </HBox>
        <HBox spacing="5">
            <Button text="Y+" onAction="#onScaleYPlus" prefWidth="50"/>
            <Button text="Y-" onAction="#onScaleYMinus" prefWidth="50"/>
        </HBox>
        <HBox spacing="5">
            <Button text="Z+" onAction="#onScaleZPlus" prefWidth="50"/>
            <Button text="Z-" onAction="#onScaleZMinus" prefWidth="50"/>
        </HBox>
        <HBox spacing="5">
            <Button text="Uniform+" onAction="#onScaleUniformPlus" prefWidth="75"/>
            <Button text="Uniform-" onAction="#onScaleUniformMinus" prefWidth="75"/>
        </HBox>

        <Separator/>

        <!-- Управление -->
        <Button text="Reset All" onAction="#onResetTransformations" prefWidth="180"/>

    </VBox>

</AnchorPane>