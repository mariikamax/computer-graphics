<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.cgvsu.GuiController"
            fx:id="anchorPane">

    <MenuBar AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <Menu text="File">
            <MenuItem text="Open Model" onAction="#onOpenModelMenuItemClick"/>
            <SeparatorMenuItem/>
            <MenuItem text="Load Texture" onAction="#handleLoadTexture"/>
        </Menu>
        <Menu text="View">
            <CheckMenuItem fx:id="wireframeCheck" text="Wireframe" onAction="#handleWireframe"/>
            <CheckMenuItem fx:id="fillPolygonsCheck" text="Fill Polygons" onAction="#handleFillPolygons" selected="true"/>
            <CheckMenuItem fx:id="textureCheck" text="Texture" onAction="#handleTexture"/>
            <CheckMenuItem fx:id="lightingCheck" text="Lighting" onAction="#handleLighting"/>
        </Menu>
        <Menu text="Camera">
            <MenuItem text="Add Camera" onAction="#addCamera"/>
            <MenuItem text="Remove Camera" onAction="#removeCamera"/>
            <Menu text="Switch Camera">
                <!-- Динамически заполняемые камеры -->
            </Menu>
        </Menu>
    </MenuBar>

    <Canvas fx:id="canvas"
            AnchorPane.topAnchor="30"
            AnchorPane.bottomAnchor="150"
            AnchorPane.leftAnchor="0"
            AnchorPane.rightAnchor="200"/>

    <!-- Панель управления справа -->
    <VBox fx:id="controlPanel" spacing="10"
          AnchorPane.topAnchor="30"
          AnchorPane.bottomAnchor="0"
          AnchorPane.rightAnchor="0"
          prefWidth="200"
          style="-fx-background-color: #f5f5f5; -fx-border-color: #ddd; -fx-border-width: 0 0 0 1;">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <Label text="Camera Controls" style="-fx-font-weight: bold;"/>
        <HBox spacing="5">
            <Button text="Forward" onAction="#handleCameraForward" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button text="Back" onAction="#handleCameraBackward" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox spacing="5">
            <Button text="Left" onAction="#handleCameraLeft" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button text="Right" onAction="#handleCameraRight" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox spacing="5">
            <Button text="Up" onAction="#handleCameraUp" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button text="Down" onAction="#handleCameraDown" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        </HBox>

        <Separator/>

        <Label text="Render Settings" style="-fx-font-weight: bold;"/>
        <CheckBox fx:id="wireframeCheckBox" text="Wireframe" onAction="#handleWireframe"/>
        <CheckBox fx:id="fillPolygonsCheckBox" text="Fill Polygons" onAction="#handleFillPolygons" selected="true"/>
        <CheckBox fx:id="textureCheckBox" text="Texture" onAction="#handleTexture"/>
        <CheckBox fx:id="lightingCheckBox" text="Lighting" onAction="#handleLighting"/>

        <Separator/>

        <Label text="Current Model:"/>
        <Label fx:id="modelNameLabel" text="No model loaded" style="-fx-font-style: italic;"/>
    </VBox>

</AnchorPane>