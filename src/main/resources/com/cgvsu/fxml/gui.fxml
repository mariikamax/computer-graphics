<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cgvsu.GuiController">

    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="Open Model" onAction="#onOpenModelMenuItemClick"/>
            </Menu>
        </MenuBar>
    </top>

    <center>
        <AnchorPane fx:id="anchorPane">
            <Canvas fx:id="canvas"
                    width="800"
                    height="600"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"/>
        </AnchorPane>
    </center>

    <right>
        <VBox fx:id="controlPanel" spacing="10" prefWidth="250">

            <!-- Информация о модели -->
            <VBox spacing="5">
                <Label text="Текущая модель:" style="-fx-font-weight: bold;"/>
                <Label fx:id="modelNameLabel" text="Нет модели"/>
            </VBox>

            <!-- Настройки рендеринга -->
            <VBox spacing="5">
                <Label text="Настройки отрисовки:" style="-fx-font-weight: bold;"/>
                <CheckBox fx:id="fillPolygonsCheckBox" text="Заливка полигонов"
                          onAction="#handleFillPolygons"/>
                <CheckBox fx:id="wireframeCheckBox" text="Полигональная сетка"
                          onAction="#handleWireframe"/>
                <CheckBox fx:id="textureCheckBox" text="Использовать текстуру"
                          onAction="#handleTexture"/>
                <CheckBox fx:id="lightingCheckBox" text="Использовать освещение"
                          onAction="#handleLighting"/>

                <HBox spacing="10">
                    <Button text="Загрузить текстуру" onAction="#handleLoadTexture"/>
                    <Button text="Выбрать цвет" onAction="#handleChooseColor"/>
                </HBox>
            </VBox>

            <!-- Управление камерой (ДОБАВЛЕНО) -->
            <VBox spacing="5">
                <Label text="Управление камерой:" style="-fx-font-weight: bold;"/>

                <GridPane hgap="5" vgap="5">
                    <Button text="Вперед" onAction="#handleCameraForward"
                            GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Button text="Назад" onAction="#handleCameraBackward"
                            GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Button text="Влево" onAction="#handleCameraLeft"
                            GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Button text="Вправо" onAction="#handleCameraRight"
                            GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <Button text="Вверх" onAction="#handleCameraUp"
                            GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                    <Button text="Вниз" onAction="#handleCameraDown"
                            GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                </GridPane>

                <HBox spacing="10">
                    <Button text="Добавить камеру" onAction="#addCamera"/>
                    <Button text="Удалить камеру" onAction="#removeCamera"/>
                </HBox>

                <HBox spacing="10">
                    <Button text="Переключить камеру" onAction="#switchCamera"/>
                    <Button text="Привязать свет" onAction="#attachLightToCamera"/>
                </HBox>
            </VBox>

        </VBox>
    </right>

</BorderPane>